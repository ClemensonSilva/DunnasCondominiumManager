#!/bin/bash -e

# Prevent stale PID from bind-mounted workspace from blocking server boot.
rm -f /rails/tmp/pids/server.pid

if ! bundle check >/dev/null 2>&1; then
  bundle install
fi

# If running the Rails server then create/migrate the database and load seeds.
if [ "$1" = "./bin/rails" ] && [ "$2" = "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
