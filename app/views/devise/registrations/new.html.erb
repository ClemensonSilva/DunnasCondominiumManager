<div class="container py-5 bg-white">
  <div class="row w-100 justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header text-white py-3" style="background-color: #1b4d5c;">
          <h1 class="h4 mb-0">Dunnas Condominium</h1>
          <p class="mb-0 small text-white-50">Criacao de conta</p>
        </div>

        <div class="card-body p-4">
          <h2 class="h5 mb-3">Cadastrar</h2>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control py-2", placeholder: "nome@empresa.com" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "Senha", class: "form-label" %>
              <% if @minimum_password_length %>
                <div class="form-text mb-2">Minimo de <%= @minimum_password_length %> caracteres.</div>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control py-2", placeholder: "Crie uma senha" %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control py-2", placeholder: "Repita a senha" %>
            </div>

            <div class="d-grid mb-3">
              <%= f.submit "Cadastrar", class: "btn text-white fw-semibold py-2", style: "background-color: #1b4d5c;" %>
            </div>
          <% end %>

          <div class="d-grid gap-1 small">
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
