<div id="<%= dom_id building %>">
  <div>
    <strong>Name:</strong>
    <%= building.name %>
  </div>

  <div>
    <strong>Condominium:</strong>
    <%= building.condominium_id %>
  </div>

  <div>
    <strong>Number of apartments:</strong>
    <%= building.number_of_apartments %>
  </div>

  <div>
    <strong>Number of floors:</strong>
    <%= building.number_of_floors %>
  </div>

</div>
