<article id="<%= dom_id building %>" class="col-12 col-sm-6 col-xl-4">
  <div class="card border-0 shadow-sm h-100 building-card">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <h2 class="h5 mb-0"><%= building.name %></h2>
        <span class="badge text-bg-light border">Predio</span>
      </div>

      <dl class="mb-0">
        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
          <dt class="text-secondary fw-medium">Apartamentos por andar</dt>
          <dd class="mb-0 fw-semibold"><%= building.apartments_per_floor %></dd>
        </div>

        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
          <dt class="text-secondary fw-medium">Numero de andares</dt>
          <dd class="mb-0 fw-semibold"><%= building.number_of_floors %></dd>
        </div>

        <div class="d-flex justify-content-between align-items-center py-2">
          <dt class="text-secondary fw-medium">Chamados</dt>
          <dd class="mb-0">
            <span class="badge rounded-pill text-bg-secondary chamados-placeholder">Aguardando variavel</span>
          </dd>
        </div>
      </dl>
      <div class="mt-4 d-flex gap-2">
        <%= link_to "Ver detalhes", building, class: "btn btn-outline-primary btn-sm" %>
              <% if can? :create, Building %>

        <%= link_to "Editar", edit_building_path(building), class: "btn btn-light btn-sm" %>
       <% end %>

      </div>
     
    </div>
  </div>
</article>
