<% content_for :title, "Buildings" %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
  <div>
    <h1 class="h2 mb-1">Buildings</h1>
    <p class="text-secondary mb-0">Visao geral dos predios cadastrados.</p>
  </div>
  <%= link_to "New building", new_building_path, class: "btn btn-primary" %>
</div>

<div class="mb-4">
  <%= render "layouts/search", path: buildings_path, placeholder: "Exemplo: Canário Verde" %>
</div>

<div id="buildings" class="row g-4">
  <% @buildings.each do |building| %>
    <%= render building %>
  <% end %>
</div>
