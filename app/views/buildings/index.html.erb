<% content_for :title, "Buildings" %>

<%= render "shared/page_header", 
           title: "Predios", 
           subtitle: "Visao geral dos predios cadastrados.",
           buttons: page_header_button(
             "+ Novo Predio",
             new_building_path,
             ability: :create,
             subject: Building,
             options: { data: { turbo_frame: "modal_container" }, class: "btn btn-primary shadow-sm" }
           ) %>

<div class="mb-4">
  <% if current_user.admin? %>
  <%= render "layouts/search", path: buildings_path, placeholder: "Exemplo: Canário Verde" %>
  <% end %>
</div>

<div id="buildings" class="row g-4">
  <% @buildings.each do |building| %>
    <%= render building %>
  <% end %>
</div>
