<% total_apartments_display = @total_apartments || (@building.number_of_floors * @building.apartments_per_floor) %>

<section class="accordion mb-4" id="buildingSummaryAccordion">
  <div class="accordion-item border-0 shadow-sm">
    <h2 class="accordion-header" id="headingSummary">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSummary" aria-expanded="false" aria-controls="collapseSummary">
        Resumo do predio
      </button>
    </h2>
    <div id="collapseSummary" class="accordion-collapse collapse" aria-labelledby="headingSummary" data-bs-parent="#buildingSummaryAccordion">
      <div class="accordion-body">
        <div class="row g-3">
          <div class="col-6 col-lg-3">
            <p class="text-secondary mb-1 small">Apartamentos</p>
            <p class="h5 mb-0"><%= total_apartments_display %></p>
          </div>
          <div class="col-6 col-lg-3">
            <p class="text-secondary mb-1 small">Andares</p>
            <p class="h5 mb-0"><%= @building.number_of_floors %></p>
          </div>
          <div class="col-6 col-lg-3">
            <p class="text-secondary mb-1 small">Aptos por andar</p>
            <p class="h5 mb-0"><%= @building.apartments_per_floor %></p>
          </div>
          <div class="col-6 col-lg-3">
            <p class="text-secondary mb-1 small">Residentes</p>
            <p class="h5 mb-0"><%= @residents_count %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
