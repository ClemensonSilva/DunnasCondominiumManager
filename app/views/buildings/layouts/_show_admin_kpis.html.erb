<section class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <%= render "buildings/layouts/insight_card",
               title: "Chamados abertos",
               card_classes: "card border-0 shadow-sm h-100",
               title_tag: :p,
               title_classes: "text-secondary mb-1" do %>
      <p class="h4 mb-0"><%= @open_tickets_count %></p>
    <% end %>
  </div>

  <div class="col-12 col-md-4">
    <%= render "buildings/layouts/insight_card",
               title: "Chamados finalizados",
               card_classes: "card border-0 shadow-sm h-100",
               title_tag: :p,
               title_classes: "text-secondary mb-1" do %>
      <p class="h4 mb-0"><%= @closed_tickets_count %></p>
    <% end %>
  </div>

  <div class="col-12 col-md-4">
    <%= render "buildings/layouts/insight_card",
               title: "SLA vencido",
               card_classes: "card border-0 shadow-sm h-100",
               title_tag: :p,
               title_classes: "text-secondary mb-1" do %>
      <p class="h4 mb-0"><%= @overdue_tickets_count %></p>
    <% end %>
  </div>
</section>
