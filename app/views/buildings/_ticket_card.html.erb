<article class="col-12 col-md-6 col-xl-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <h3 class="h6 mb-0"><%= ticket.title.presence || "Chamado sem titulo" %></h3>
        <% status_title = ticket.ticket_status&.title || "Sem status" %>
        <span class="badge <%= ticket_status_badge_class(status_title) %>"><%= status_title %></span>
      </div>

      <dl class="mb-0">
        <div class="d-flex justify-content-between py-2 border-bottom">
          <dt class="text-secondary fw-medium">Apartamento</dt>
          <dd class="mb-0 fw-semibold"><%= ticket.apartment&.identificator || "-" %></dd>
        </div>

        <div class="d-flex justify-content-between py-2 border-bottom">
          <dt class="text-secondary fw-medium">Tipo</dt>
          <dd class="mb-0"><%= ticket.ticket_type&.title || "-" %></dd>
        </div>

        <div class="d-flex justify-content-between py-2">
          <dt class="text-secondary fw-medium">Solicitante</dt>
          <dd class="mb-0"><%= ticket.user&.name || ticket.user&.email || "-" %></dd>
        </div>
      </dl>

      <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
        <small class="text-secondary"><%= ticket.created_at.strftime("%d/%m/%Y %H:%M") %></small>
        <%= link_to "Ver chamado", ticket_path(ticket), class: "btn btn-outline-primary btn-sm" %>
      </div>
    </div>
  </div>
</article>
