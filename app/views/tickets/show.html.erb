<% content_for :title, "Detalhes do ticket" %>

<section class="container-fluid px-0">
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h4 mb-1"><%= @ticket.title.presence || "Ticket sem titulo" %></h1>
        <p class="text-secondary mb-0">Visualizacao completa do chamado.</p>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <% if can_take_ticket?(@ticket) %>
          <%= button_to "Pegar ticket",
                        take_ticket_path(@ticket),
                        method: :patch,
                        class: "btn btn-outline-secondary",
                        form_class: "d-inline" %>
        <% end %>
        <% if can? :update, @ticket %>
          <%= link_to "Editar ticket", edit_ticket_path(@ticket), class: "btn btn-outline-primary", data: { turbo_frame: "modal_container" } %>
        <% end %>
        <%= link_to "Voltar", tickets_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="row g-3">
        <%= render "show_detail_item", label: "Apartamento", value: @ticket.apartment&.identificator || "-" %>
        <%= render "show_detail_item", label: "Tipo de reparo", value: @ticket.ticket_type&.title || "-" %>
        <%= render "show_detail_item", label: "Status", value: @ticket.ticket_status&.title || "-" %>
        <%= render "show_detail_item", label: "Solicitante", value: ticket_person_display(@ticket.user) %>
        <%= render "show_detail_item", label: "Colaborador responsavel", value: ticket_person_display(@ticket.collaborator, "Nao atribuido") %>
        <%= render "show_detail_item", label: "Anexos", value: @ticket.attachments.presence || "-" %>
        <%= render "show_detail_item", label: "Criado em", value: ticket_datetime_display(@ticket.created_at) %>
        <%= render "show_detail_item", label: "Atualizado em", value: ticket_datetime_display(@ticket.updated_at) %>
        <%= render "show_detail_item", label: "Finalizacao", value: ticket_datetime_display(@ticket.finished_at) %>
        <%= render "show_detail_item", label: "Descricao", value: @ticket.description.presence || "Sem descricao.", col_classes: "col-12", value_tag: :p, value_classes: "mb-0" %>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <% if can? :destroy, @ticket %>
      <%= button_to "Excluir ticket", @ticket, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Tem certeza que deseja excluir este ticket?" } } %>
    <% end %>
    <%= link_to "Ver timeline de comentarios",
                ticket_comments_path(@ticket, return_to: request.fullpath),
                data: { turbo_frame: "modal_container" },
                class: "btn btn-outline-secondary" %>
    <% if can? :create, Comment %>
      <%= link_to "Adicionar comentário", new_ticket_comment_path(@ticket), class: "btn btn-outline-primary" %>
    <% end %>
    <% if can_finalize_ticket?(@ticket) %>
      <%= button_to "Marcar como Concluído", finalize_ticket_path(@ticket), method: :patch, class: "btn btn-outline-primary" %>
    <% end %>
  </div>
</section>
