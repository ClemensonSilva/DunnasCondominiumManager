<% content_for :title, "Detalhes do ticket" %>

<section class="container-fluid px-0">
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h1 class="h4 mb-1"><%= @ticket.title.presence || "Ticket sem titulo" %></h1>
        <p class="text-secondary mb-0">Visualizacao completa do chamado.</p>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <% if can? :update, @ticket %>
          <%= link_to "Editar ticket", edit_ticket_path(@ticket), class: "btn btn-outline-primary", data: { turbo_frame: "modal_container" } %>
        <% end %>
        <%= link_to "Voltar", tickets_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Apartamento</span>
          <strong><%= @ticket.apartment&.identificator || "-" %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Tipo de reparo</span>
          <strong><%= @ticket.ticket_type&.title || "-" %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Status</span>
          <strong><%= @ticket.ticket_status&.title || "-" %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Solicitante</span>
          <strong><%= @ticket.user&.name || @ticket.user&.email || "-" %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Colaborador responsavel</span>
          <strong><%= @ticket.collaborator&.name || @ticket.collaborator&.email || "Nao atribuido" %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Anexos</span>
          <strong><%= @ticket.attachments.presence || "-" %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Criado em</span>
          <strong><%= l(@ticket.created_at, format: :short) %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Atualizado em</span>
          <strong><%= l(@ticket.updated_at, format: :short) %></strong>
        </div>

        <div class="col-12 col-md-6">
          <span class="text-secondary d-block">Finalizacao</span>
          <strong><%= @ticket.finished_at ? l(@ticket.finished_at, format: :short) : "-" %></strong>
        </div>

        <div class="col-12">
          <span class="text-secondary d-block">Descricao</span>
          <p class="mb-0"><%= @ticket.description.presence || "Sem descricao." %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <% if can? :destroy, @ticket %>
      <%= button_to "Excluir ticket", @ticket, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Tem certeza que deseja excluir este ticket?" } } %>
    <% end %>
    <%= link_to "Ver timeline de comentarios",
                ticket_comments_path(@ticket, return_to: request.fullpath),
                data: { turbo_frame: "modal_container" },
                class: "btn btn-outline-secondary" %>
    <% if can? :create, Comment %>
      <%= link_to "Adicionar comentário", new_ticket_comment_path(@ticket), class: "btn btn-outline-primary" %>
    <% end %>
  </div>
</section>
