<% content_for :title, "Tickets" %>

<section class="container-fluid px-0">
  <% header_buttons = if can?(:create, Ticket)
    capture do
      link_to "+ Novo Ticket", new_ticket_path, data: { turbo_frame: "modal_container" }, class: "btn btn-primary shadow-sm"
    end
  end %>

  <%= render "shared/page_header",
             title: "Tickets",
             subtitle: "Visao geral dos tickets cadastrados.",
             buttons: header_buttons %>

  <%= render "filters",
             ticket_status_filter_options: @ticket_status_filter_options,
             ticket_type_filter_options: @ticket_type_filter_options,
             apartment_filter_options: @apartment_filter_options %>

  <% if @tickets.any? %>
    <%= render "ticket_list", tickets: @tickets %>
  <% end %>

  <% unless @tickets.any? %>
    <%= render "empty_state" %>
  <% end %>
</section>
