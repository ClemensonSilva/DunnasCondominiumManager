<div class="d-none" data-ticket-wizard-target="step">
  <div class="card border-0 bg-light-subtle">
    <div class="card-body p-4">
      <h3 class="h6 mb-3">Etapa 3. Informacoes complementares</h3>
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <%= form.label :files, "Anexos (opcional)", class: "form-label" %>
          <%= form.file_field :files,
                              multiple: true,
                              direct_upload: true,
                              accept: "image/png,image/jpeg,application/pdf",
                              class: "form-control",
                              data: { ticket_wizard_target: "filesInput" } %>
          <small class="text-secondary">PNG, JPEG ou PDF. Maximo 4MB por arquivo.</small>
        </div>

        <div class="col-12 col-lg-6">
          <%= form.label :finished_at, "Data prevista de conclusao", class: "form-label" %>
          <input type="text" class="form-control" data-ticket-wizard-target="estimatedDisplay" readonly>
        </div>
      </div>
    </div>
  </div>
</div>
