<% form_dom_id = local_assigns.fetch(:form_id, dom_id(ticket, ticket.persisted? ? :edit : :new)) %>

<%= form_with(model: ticket, id: form_dom_id, data: { controller: "modal", modal_modal_id_value: "ticketWizardModal", modal_auto_open_value: ticket.new_record?, turbo_frame: "_top" }) do |form| %>
  <% if ticket.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6 mb-2"><%= pluralize(ticket.errors.count, "erro") %> impediram este chamado de ser salvo:</h2>
      <ul class="mb-0 ps-3">
        <% ticket.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if ticket.persisted? %>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 p-lg-5 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
          <h2 class="h5 mb-2">Assistente de chamado</h2>
          <p class="text-secondary mb-0">Abra o wizard para preencher o chamado em etapas e revisar antes de salvar.</p>
        </div>

        <button type="button" class="btn btn-primary" data-action="modal#open" data-modal-id-param="ticketWizardModal">
          Abrir assistente
        </button>
      </div>
    </div>
  <% end %>

  <%= render "wizard_modal", form: form, ticket: ticket, form_dom_id: form_dom_id, auto_calculate_finished_at: true %>
<% end %>
