<%= form_with(model: ticket) do |form| %>
  <% if ticket.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(ticket.errors.count, "error") %> prohibited this ticket from being saved:</h2>

      <ul>
        <% ticket.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :apartment_id, style: "display: block" %>
    <%= form.text_field :apartment_id %>
  </div>

  <div>
    <%= form.label :ticket_status_id, style: "display: block" %>
    <%= form.text_field :ticket_status_id %>
  </div>

  <div>
    <%= form.label :ticket_type_id, style: "display: block" %>
    <%= form.text_field :ticket_type_id %>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :attachments, style: "display: block" %>
    <%= form.text_field :attachments %>
  </div>

  <div>
    <%= form.label :finished_at, style: "display: block" %>
    <%= form.datetime_field :finished_at %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
