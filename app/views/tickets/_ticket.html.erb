<div id="<%= dom_id ticket %>">
  <div>
    <strong>User:</strong>
    <%= ticket.user_id %>
  </div>

  <div>
    <strong>Apartment:</strong>
    <%= ticket.apartment_id %>
  </div>

  <div>
    <strong>Ticket status:</strong>
    <%= ticket.ticket_status_id %>
  </div>

  <div>
    <strong>Ticket type:</strong>
    <%= ticket.ticket_type_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= ticket.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= ticket.description %>
  </div>

  <div>
    <strong>Attachments:</strong>
    <%= ticket.attachments %>
  </div>

  <div>
    <strong>Finished at:</strong>
    <%= ticket.finished_at %>
  </div>

</div>
