<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: tickets_path, method: :get, class: "row g-3 align-items-end", data: { controller: "ticket-filters", action: "change->ticket-filters#submit" } do |form| %>
      <div class="col-12 col-md-6 col-lg-3">
        <%= form.label :ticket_status_id, "Status", class: "form-label" %>
        <%= form.select :ticket_status_id,
                        options_from_collection_for_select(ticket_status_filter_options, :id, :title, params[:ticket_status_id]),
                        { include_blank: "Todos" },
                        class: "form-select" %>
      </div>

      <div class="col-12 col-md-6 col-lg-3">
        <%= form.label :ticket_type_id, "Tipo de reparo", class: "form-label" %>
        <%= form.select :ticket_type_id,
                        options_from_collection_for_select(ticket_type_filter_options, :id, :title, params[:ticket_type_id]),
                        { include_blank: "Todos" },
                        class: "form-select" %>
      </div>

      <div class="col-12 col-md-6 col-lg-3">
        <%= form.label :apartment_id, "Apartamento", class: "form-label" %>
        <%= form.collection_select :apartment_id,
                                   apartment_filter_options,
                                   :id,
                                   :label_with_building,
                                   { include_blank: "Todos" },
                                   class: "form-select" %>
      </div>

      <div class="col-12 col-md-6 col-lg-3">
        <%= form.label :collaborator_state, "Colaborador", class: "form-label" %>
        <%= form.select :collaborator_state,
                        options_for_select([ ["Todos", ""], ["Com colaborador", "assigned"], ["Sem colaborador", "unassigned"] ], params[:collaborator_state]),
                        {},
                        class: "form-select" %>
      </div>
      <% if current_user&.colaborator? %>
        <div class="col-12 col-md-6 col-lg-3">
          <%= form.label :my_tickets, "Meus tickets", class: "form-label" %>
          <%= form.check_box :my_tickets, { checked: params[:my_tickets] == "true" }, "true", "false" %>
        </div>
      <% end %>

      <div class="col-12 d-flex gap-2">
        <%= form.submit "Filtrar", class: "btn btn-outline-primary" %>
        <%= link_to "Limpar", tickets_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
