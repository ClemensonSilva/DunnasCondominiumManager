<% content_for :title, "Editing ticket" %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal_container" do %>
    <div data-controller="modal" data-modal-auto-open-value="true" data-modal-close-path-value="<%= ticket_path(@ticket) %>">
      <div class="modal fade" id="ticketEditModal" tabindex="-1" aria-labelledby="ticketEditModalLabel" aria-hidden="true" data-modal-target="modal">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
              <h2 class="modal-title fs-5" id="ticketEditModalLabel">Editar ticket</h2>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <%= form_with model: @ticket, class: "modal-body" do |form| %>
              <% if @ticket.errors.any? %>
                <div class="alert alert-danger" role="alert">
                  <h3 class="h6 mb-2"><%= pluralize(@ticket.errors.count, "erro") %> impediram a atualizacao:</h3>
                  <ul class="mb-0 ps-3">
                    <% @ticket.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div class="row g-3">
                <% if current_user&.colaborator? %>
                  <div class="col-12">
                    <div class="alert alert-info mb-0" role="alert">
                      Como colaborador, voce pode atualizar apenas status e finalizacao do chamado.
                    </div>
                  </div>

                  <div class="col-12 col-md-6">
                    <%= form.label :ticket_status_id, "Status", class: "form-label" %>
                    <%= form.collection_select :ticket_status_id, @edit_ticket_status_options, :id, :title, { prompt: "Selecione" }, class: "form-select", required: true %>
                  </div>

                  <div class="col-12 col-md-6">
                    <%= form.label :finished_at, "Data de finalizacao", class: "form-label" %>
                    <%= form.datetime_local_field :finished_at, class: "form-control" %>
                  </div>
                <% else %>
                  <div class="col-12 col-md-6">
                    <%= form.label :apartment_id, "Apartamento", class: "form-label" %>
                    <%= form.collection_select :apartment_id, @edit_apartment_options, :id, :identificator, { prompt: "Selecione" }, class: "form-select", required: true %>
                  </div>

                  <div class="col-12 col-md-6">
                    <%= form.label :ticket_type_id, "Tipo de reparo", class: "form-label" %>
                    <%= form.collection_select :ticket_type_id, @edit_ticket_type_options, :id, :title, { prompt: "Selecione" }, class: "form-select", required: true %>
                  </div>

                  <div class="col-12 col-md-6">
                    <%= form.label :ticket_status_id, "Status", class: "form-label" %>
                    <%= form.collection_select :ticket_status_id, @edit_ticket_status_options, :id, :title, { prompt: "Selecione" }, class: "form-select", required: true %>
                  </div>

                  <div class="col-12 col-md-6">
                    <%= form.label :finished_at, "Data de finalizacao", class: "form-label" %>
                    <%= form.datetime_local_field :finished_at, class: "form-control" %>
                  </div>

                  <div class="col-12">
                    <%= form.label :title, "Titulo", class: "form-label" %>
                    <%= form.text_field :title, class: "form-control", required: true %>
                  </div>

                  <div class="col-12">
                    <%= form.label :description, "Descricao", class: "form-label" %>
                    <%= form.text_area :description, rows: 5, class: "form-control", required: true %>
                  </div>

                  <div class="col-12">
                    <%= form.label :files, "Anexos", class: "form-label" %>
                    <%= form.file_field :files,
                                        multiple: true,
                                        direct_upload: true,
                                        accept: "image/png,image/jpeg,application/pdf",
                                        class: "form-control" %>
                    <small class="text-secondary">Voce pode selecionar um ou mais arquivos (PNG, JPEG, PDF).</small>

                    <% if @ticket.files.attached? %>
                      <div class="mt-2 p-2 border rounded bg-light-subtle">
                        <p class="mb-2 small fw-semibold">Arquivos ja anexados:</p>
                        <ul class="mb-0 ps-3 small">
                          <% @ticket.files.each do |file| %>
                            <li><%= file.filename %> (<%= number_to_human_size(file.byte_size) %>)</li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <div class="modal-footer px-0 pb-0 mt-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <%= form.submit "Salvar alteracoes", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <h1>Editing ticket</h1>

  <%= render "form", ticket: @ticket %>

  <br>

  <div>
    <%= link_to "Show this ticket", @ticket %> |
    <%= link_to "Back to tickets", tickets_path %>
  </div>
<% end %>
