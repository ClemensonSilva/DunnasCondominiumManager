<% ticket = local_assigns[:ticket] || @comment&.ticket %>
<%= form_with(model: [@comment.ticket, @comment]) do |form| %>
  <% if @comment.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h3 class="h6 mb-2"><%= pluralize(@comment.errors.count, "erro") %> impediram a criação do comentário:</h3>
      <ul class="mb-0 ps-3">
        <% @comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :content, "Comentário", class: "form-label" %>
    <%= form.textarea :content, rows: 5, class: "form-control", placeholder: "Digite seu comentário aqui...", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :files, "Anexar arquivos (opcional)", class: "form-label" %>
    <%= form.file_field :files,
                        multiple: true,
                        direct_upload: true,
                        accept: "image/png,image/jpeg,application/pdf",
                        class: "form-control" %>
    <small class="text-secondary">Formatos aceitos: PNG, JPEG e PDF. Maximo de 4MB por arquivo.</small>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "Enviar comentário", class: "btn btn-primary" %>
    <%= link_to "Cancelar", @comment.ticket, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
