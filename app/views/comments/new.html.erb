<% content_for :title, "Novo comentário" %>

<section class="container-fluid px-0">
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <h1 class="h4 mb-1">Adicionar comentário</h1>
      <p class="text-secondary mb-0">Deixe seu comentário sobre o chamado.</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <%= render "form", comment: @comment %>
    </div>
  </div>
</section>
