<article class="card border-0 shadow-sm position-relative">
  <div class="card-body">
    <span
      class="position-absolute top-0 start-0 translate-middle p-2 bg-primary border border-light rounded-circle"
      aria-hidden="true"
      style="margin-left: 0.75rem; margin-top: 1.1rem;"
    ></span>

    <div class="ms-2">
      <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-2">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <h3 class="h6 mb-0"><%= comment_owner_name(comment) %></h3>
            <span class="<%= comment_owner_role_badge_class(comment) %>" aria-label="Tipo de usuario">
              <%= comment_owner_role_label(comment) %>
            </span>
          </div>
          <p class="text-secondary small mb-0"><%= comment_timeline_title(comment) %></p>
        </div>
      </div>

      <div class="pt-2 border-top" data-controller="expandable-text">
        <p class="mb-0">
          <span data-expandable-text-target="preview"><%= comment_preview_text(comment).presence || "Sem descricao." %></span>
          <span class="d-none" data-expandable-text-target="full"><%= comment.content.presence || "Sem descricao." %></span>

          <% if comment_preview_truncated?(comment) %>
            <button
              type="button"
              class="btn btn-link btn-sm px-0 ms-1 align-baseline"
              data-action="expandable-text#toggle"
              data-expandable-text-target="toggle"
              aria-expanded="false"
            >
              Ver mais
            </button>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</article>
