<aside class="position-fixed top-0 start-0 vh-100 col-12 col-md-3 col-lg-2 text-white d-flex flex-column justify-content-between p-3" style="background-color: #1b4d5c;">
	<% ticket_tree_open = %w[tickets comments ticket_statuses scopes].include?(controller_name) %>
	<% users_tree_open = controller_name == "users" %>
	<% ticket_root_class = ticket_tree_open ? "d-flex align-items-center justify-content-between gap-2 bg-light text-dark rounded" : "d-flex align-items-center justify-content-between gap-2 text-white" %>
	<% ticket_link_class = ticket_tree_open ? "nav-link flex-grow-1 px-3 py-2 text-dark text-decoration-none fw-medium rounded" : "nav-link flex-grow-1 px-3 py-2 text-white text-decoration-none fw-medium rounded" %>
	<% users_root_class = users_tree_open ? "d-flex align-items-center justify-content-between gap-2 bg-light text-dark rounded" : "d-flex align-items-center justify-content-between gap-2 text-white" %>
	<% user_link_class = users_tree_open ? "nav-link flex-grow-1 px-3 py-2 text-dark text-decoration-none fw-medium rounded" : "nav-link flex-grow-1 px-3 py-2 text-white text-decoration-none fw-medium rounded" %>
	<div>
		<div class="border-bottom border-light border-opacity-25 pb-3 mb-3">
			<h6 class="mb-1"><%= current_user.name.presence || "Usuario" %></h6>
			<small class="text-white-50"><%= current_user.email %></small>
		</div>

		<nav class="nav nav-pills flex-column gap-1" aria-label="Operacao">
			<%= link_to "Predios", buildings_path, class: "nav-link #{controller_name == 'buildings' ? 'bg-light text-dark' : 'text-white'}" %>

			<div class="mb-1">
				<div class="<%= ticket_root_class %>">
					<%= link_to "Tickets", tickets_path, class: ticket_link_class %>
					<button
						type="button"
						class="btn btn-sm p-0 border-0 bg-transparent text-reset"
						data-bs-toggle="collapse"
						data-bs-target="#ticketsTree"
						aria-expanded="<%= ticket_tree_open %>"
						aria-controls="ticketsTree"
					>
						<span class="small"><%= ticket_tree_open ? '▾' : '▸' %></span>
					</button>
				</div>

				<div class="collapse <%= 'show' if ticket_tree_open %>" id="ticketsTree">
					<div class="mt-1 ms-3 ps-2 border-start border-light border-opacity-25 d-grid gap-1">
						<%= link_to "Comentarios", comments_path, class: "nav-link py-1 px-2 rounded #{controller_name == 'comments' ? 'bg-light text-dark' : 'text-white'}" %>
						<%= link_to "Status de tickets", ticket_statuses_path, class: "nav-link py-1 px-2 rounded #{controller_name == 'ticket_statuses' ? 'bg-light text-dark' : 'text-white'}" %>
						<%= link_to "Escopos", scopes_path, class: "nav-link py-1 px-2 rounded #{controller_name == 'scopes' ? 'bg-light text-dark' : 'text-white'}" %>
					</div>
				</div>
			</div>

			<div class="mb-1">
				<div class="<%= users_root_class %>">
					<%= link_to "Usuarios", users_path, class: user_link_class %>
					<button
						type="button"
						class="btn btn-sm p-0 border-0 bg-transparent text-reset"
						data-bs-toggle="collapse"
						data-bs-target="#usersTree"
						aria-expanded="<%= users_tree_open %>"
						aria-controls="usersTree"
					>
						<span class="small"><%= users_tree_open ? '▾' : '▸' %></span>
					</button>
				</div>

				<div class="collapse <%= 'show' if users_tree_open %>" id="usersTree">
					<div class="mt-1 ms-3 ps-2 border-start border-light border-opacity-25 d-grid gap-1">
						<%= link_to "Residentes", residents_users_path, class: "nav-link py-1 px-2 rounded #{controller_name == 'users' && action_name == 'residents' ? 'bg-light text-dark' : 'text-white'}" %>
						<%= link_to "Colaboradores", colaborators_users_path, class: "nav-link py-1 px-2 rounded #{controller_name == 'users' && action_name == 'colaborators' ? 'bg-light text-dark' : 'text-white'}" %>
					</div>
				</div>
			</div>
		</nav>
	</div>

	<div>
		<%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-light text-dark w-100" %>
	</div>
</aside>
