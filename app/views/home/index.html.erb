<% content_for :title, "Dunnas Condominium" %>

<div class="container-fluid px-0">
  <section class="py-5 bg-white">
    <div class="container py-4">
      <div class="row align-items-center g-4">
        <div class="col-12 col-lg-7">
          <h1 class="display-5 fw-bold" style="color: #1b4d5c;">Gestao inteligente para condominios modernos</h1>
          <p class="lead text-secondary mt-3">
            Centralize chamados, equipes de colaboracao e comunicacao com moradores em uma unica plataforma.
            Mais controle operacional, menos retrabalho e respostas mais rapidas.
          </p>
          <div class="d-flex gap-2 mt-4">
            <%= link_to "Acessar Plataforma", new_user_session_path, class: "btn text-white px-4", style: "background-color: #1b4d5c;" %>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <h2 class="h5 mb-3" style="color: #1b4d5c;">Por que o Dunnas?</h2>
              <ul class="list-group list-group-flush">
                <li class="list-group-item px-0">Abertura e acompanhamento de tickets em tempo real</li>
                <li class="list-group-item px-0">Fluxo claro entre administrador, colaborador e morador</li>
                <li class="list-group-item px-0">Organizacao por escopos de atuacao e prioridade</li>
                <li class="list-group-item px-0">Historico completo para auditoria e melhoria continua</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5" style="background-color: #f4f8fa;">
    <div class="container">
      <div class="row g-4">
        <div class="col-12 col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h3 class="h6 text-uppercase fw-bold" style="color: #1b4d5c;">Operacao</h3>
              <p class="mb-0 text-secondary">Distribuicao inteligente de demandas para cada equipe responsavel.</p>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h3 class="h6 text-uppercase fw-bold" style="color: #1b4d5c;">Visibilidade</h3>
              <p class="mb-0 text-secondary">Acompanhe status e tempos de resposta sem perder informacoes.</p>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h3 class="h6 text-uppercase fw-bold" style="color: #1b4d5c;">Padronizacao</h3>
              <p class="mb-0 text-secondary">Processos consistentes para elevar qualidade no atendimento.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
