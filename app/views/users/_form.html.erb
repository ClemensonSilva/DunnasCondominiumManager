<% modal = local_assigns.fetch(:modal, false) %>

<%= form_with(model: user, html: { data: { controller: "user-role-form" } }) do |form| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6 mb-2"><%= pluralize(user.errors.count, "erro") %> impediram este usuario de ser salvo:</h2>
      <ul class="mb-0 ps-3">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <%= form.label :name, "Nome", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", autocomplete: "name", required: true %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :email, "Email", class: "form-label" %>
      <%= form.email_field :email, class: "form-control", autocomplete: "email", required: true %>
    </div>

    <% if current_user&.admin? %>
      <div class="col-12 col-md-6">
        <%= form.label :user_type, "Tipo de usuario", class: "form-label" %>
        <%= form.select :user_type,
                        User.user_types.keys.reject { |type| type == "admin" }.map { |type| [type.humanize, type] },
                        { include_blank: "Selecione" },
                        {
                          class: "form-select",
                          data: {
                            action: "change->user-role-form#userTypeChanged",
                            user_role_form_target: "userType"
                          }
                        } %>
      </div>

      <div class="col-12" data-user-role-form-target="scopeSection">
        <%= form.label :scope_ids, "Escopos (para colaborador)", class: "form-label" %>
        <%= render "association_checkboxes",
                   form: form,
                   field: :scope_ids,
                   collection: @available_scopes,
                   value_method: :id,
                   text_method: :title,
                   target: "scopeInputs" %>
        <small class="form-text text-secondary">Visivel apenas quando o tipo for colaborador.</small>
      </div>

      <div class="col-12" data-user-role-form-target="apartmentSection">
        <%= label_tag :building_id_filter, "Prédio", class: "form-label" %>
        <%= select_tag :building_id_filter,
                       options_for_select([["Selecione um prédio", ""]] + @available_buildings.map { |building| [building.name, building.id] }, @selected_building_id),
                       class: "form-select",
                       data: {
                         action: "change->user-role-form#buildingChanged",
                         user_role_form_target: "buildingSelect"
                       } %>
        <small class="form-text text-secondary d-block mt-2">
          Primeiro escolha o prédio. Depois o sistema mostra apenas os apartamentos disponíveis daquele bloco.
        </small>

        <div class="mt-3 d-grid gap-3" data-user-role-form-target="apartmentGroups">
          <% @available_buildings.each do |building| %>
            <div class="d-none" data-user-role-form-target="apartmentGroup" data-building-id-value="<%= building.id %>">
              <div class="border rounded-3 p-3 bg-light-subtle">
                <h6 class="mb-3"><%= building.name %></h6>

                <%= render "association_checkboxes",
                           form: form,
                           field: :apartment_ids,
                           collection: (@available_apartments_by_building[building.id] || []),
                           value_method: :id,
                           text_method: :identificator,
                           target: "apartmentInputs" %>
              </div>
            </div>
          <% end %>
        </div>

        <small class="form-text text-secondary d-block mt-2">Visivel apenas quando o tipo for morador.</small>
      </div>
    <% end %>

    <div class="col-12 col-md-6">
      <%= form.label :password, "Senha", class: "form-label" %>
      <%= form.password_field :password, class: "form-control", autocomplete: "new-password" %>
      <% if user.persisted? %>
        <small class="form-text text-secondary">Preencha apenas se quiser alterar a senha.</small>
      <% end %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :password_confirmation, "Confirmacao da senha", class: "form-label" %>
      <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
    </div>
  </div>

  <div class="mt-4 d-flex flex-wrap gap-2">
    <%= form.submit(user.persisted? ? "Salvar alteracoes" : "Criar usuario", class: "btn btn-primary") %>
    <% if modal && user.persisted? %>
      <%= link_to "Excluir usuario",
                  user_path(user),
                  class: "btn btn-outline-danger",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Tem certeza que deseja excluir este usuario?",
                    turbo_frame: "_top"
                  } %>
    <% end %>
    <% unless modal %>
      <%= link_to "Voltar", users_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>
