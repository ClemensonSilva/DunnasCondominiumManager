<div class="row g-3">
  <div class="col-12 col-md-6">
    <div class="p-3 border rounded-3 bg-light h-100">
      <div class="text-secondary small mb-1">Nome</div>
      <div class="fw-semibold"><%= user.name %></div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="p-3 border rounded-3 bg-light h-100">
      <div class="text-secondary small mb-1">Email</div>
      <div class="fw-semibold text-break"><%= user.email %></div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="p-3 border rounded-3 bg-light h-100">
      <div class="text-secondary small mb-1">Tipo</div>
      <div class="fw-semibold text-capitalize"><%= user.user_type %></div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="p-3 border rounded-3 bg-light h-100">
      <div class="text-secondary small mb-1">Escopos</div>
      <div class="fw-semibold"><%= user.scopes.map(&:title).join(", ").presence || "-" %></div>
    </div>
  </div>

  <div class="col-12">
    <div class="p-3 border rounded-3 bg-light h-100">
      <div class="text-secondary small mb-1">Apartamentos</div>
      <div class="fw-semibold"><%= user.apartments.includes(:building).map(&:label_with_building).join(", ").presence || "-" %></div>
    </div>
  </div>
</div>