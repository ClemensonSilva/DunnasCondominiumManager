<% content_for :title, @user.name %>

<% if turbo_frame_request? %>
  <%= render layout: "shared/modal", locals: { title: @user.name, close_path: users_path } do %>
    <%= render "details", user: @user %>
  <% end %>
<% else %>
  <%= render "shared/page_header",
             title: @user.name,
             subtitle: "Detalhes do usuario cadastrado.",
             buttons: (
               link_to("Editar", edit_user_path(@user), data: { turbo_frame: "modal_container" }, class: "btn btn-outline-primary") +
               link_to("Voltar", users_path, class: "btn btn-outline-secondary")
             ) %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <%= render "details", user: @user %>

      <div class="mt-4 d-flex gap-2">
        <%= button_to "Excluir usuario", @user, method: :delete, class: "btn btn-danger" %>
      </div>
    </div>
  </div>
<% end %>
