<div class="border rounded-3 p-3 bg-light-subtle" data-user-role-form-target="<%= target %>">
  <div class="row g-2">
    <%= form.collection_check_boxes field, collection, value_method, text_method do |builder| %>
      <div class="col-12 col-sm-6 col-lg-4">
        <div class="form-check">
          <%= builder.check_box class: "form-check-input" %>
          <%= builder.label class: "form-check-label" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
