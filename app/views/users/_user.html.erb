<article id="<%= dom_id user %>" class="col-12 col-md-6 col-xl-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <h2 class="h5 mb-0"><%= user.name %></h2>
        <span class="badge text-bg-light border text-capitalize"><%= user.user_type %></span>
      </div>

      <dl class="mb-0">
        <div class="py-2 border-bottom">
          <dt class="text-secondary fw-medium">Email</dt>
          <dd class="mb-0 fw-semibold text-break"><%= user.email %></dd>
        </div>
      </dl>

      <div class="mt-4 d-flex gap-2">
        <%= link_to "Ver", user, data: { turbo_frame: "modal_container" }, class: "btn btn-outline-primary btn-sm" %>
        <%= link_to "Editar", edit_user_path(user), data: { turbo_frame: "modal_container" }, class: "btn btn-light btn-sm" %>
      </div>
    </div>
  </div>
</article>
