<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

  <div>
    <strong>User type:</strong>
    <%= user.user_type %>
  </div>

  <div>
    <strong>Scopes:</strong>
    <%= user.scopes.map(&:title).join(", ").presence || "-" %>
  </div>

  <div>
    <strong>Apartments:</strong>
    <%= user.apartments.map(&:identificator).join(", ").presence || "-" %>
  </div>

  

</div>
